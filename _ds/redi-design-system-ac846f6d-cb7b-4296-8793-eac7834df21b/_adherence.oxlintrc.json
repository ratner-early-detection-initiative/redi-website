{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/content/**",
              "components/figma-sets/**",
              "components/media/**",
              "components/navigation/**",
              "components/sections/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:TT Rationalist Trl|TT Rationalist Trial|Neue Haas Grotesk Display Std|NeueHaasGroteskDisp W02|Neue Haas Grotesk Display Pro|NeueHaasGroteskDisp W02 Bd|NeueHaasGroteskDisp W02 Lt|Plain))/i]",
        "message": "Font not provided by the design system. Available: TT Rationalist Trl, TT Rationalist Trial, Neue Haas Grotesk Display Std, NeueHaasGroteskDisp W02, Neue Haas Grotesk Display Pro, NeueHaasGroteskDisp W02 Bd, NeueHaasGroteskDisp W02 Lt, Plain."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigTextCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|size|tone|state|style|key|ref|className|style|children)$/]",
        "message": "<BigTextCTA> doesn't accept that prop. Declared props: children, href, size, tone, state, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigTextCTA'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|active)$/]",
        "message": "<BigTextCTA> state must be one of 'default' | 'active'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|lines|style|key|ref|className|style|children)$/]",
        "message": "<BrandLockup> doesn't accept that prop. Declared props: size, tone, lines, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|fill|size|as|href|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, fill, size, as, href, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='fill'] > Literal[value!=/^(?:neutral|mist|white)$/]",
        "message": "<Button> fill must be one of 'neutral' | 'mist' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:full|compact)$/]",
        "message": "<Button> size must be one of 'full' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a|div)$/]",
        "message": "<Button> as must be one of 'button' | 'a' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:breakpoint|links|name|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: breakpoint, links, name, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute[name.name='breakpoint'] > Literal[value!=/^(?:desktop|tablet|mobile)$/]",
        "message": "<Footer> breakpoint must be one of 'desktop' | 'tablet' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GetInvolvedButtonHoverState'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|property1|style|key|ref|className|style|children)$/]",
        "message": "<GetInvolvedButtonHoverState> doesn't accept that prop. Declared props: children, property1, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GetInvolvedButtonHoverState'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|variant2)$/]",
        "message": "<GetInvolvedButtonHoverState> property1 must be one of 'default' | 'variant2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GetScreened'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|property1|style|key|ref|className|style|children)$/]",
        "message": "<GetScreened> doesn't accept that prop. Declared props: children, property1, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GetScreened'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|variant2)$/]",
        "message": "<GetScreened> property1 must be one of 'default' | 'variant2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<HeaderItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadingMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|duration|loop|style|key|ref|className|style|children)$/]",
        "message": "<LoadingMark> doesn't accept that prop. Declared props: width, duration, loop, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|width|rule|title|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: tone, width, rule, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:black|red|white|inherit)$/]",
        "message": "<Logo> tone must be one of 'black' | 'red' | 'white' | 'inherit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|kind|linkLabel|showLink|href|width|onPlay|style|key|ref|className|style|children)$/]",
        "message": "<MediaCard> doesn't accept that prop. Declared props: image, title, kind, linkLabel, showLink, href, width, onPlay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:article|video)$/]",
        "message": "<MediaCard> kind must be one of 'article' | 'video'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|current|onClose|style|key|ref|className|style|children)$/]",
        "message": "<MobileMenu> doesn't accept that prop. Declared props: items, current, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|current|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: children, href, current, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OurMissonButtonHoverState'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|property1|style|key|ref|className|style|children)$/]",
        "message": "<OurMissonButtonHoverState> doesn't accept that prop. Declared props: children, property1, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OurMissonButtonHoverState'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|variant2)$/]",
        "message": "<OurMissonButtonHoverState> property1 must be one of 'default' | 'variant2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|label|variant|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PlayButton> doesn't accept that prop. Declared props: size, label, variant, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|inverse)$/]",
        "message": "<PlayButton> variant must be one of 'default' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressTrack'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|total|height|style|key|ref|className|style|children)$/]",
        "message": "<ProgressTrack> doesn't accept that prop. Declared props: value, total, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrollableList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|size|gap|style|key|ref|className|style|children)$/]",
        "message": "<ScrollableList> doesn't accept that prop. Declared props: items, active, onSelect, size, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|height|style|key|ref|className|style|children)$/]",
        "message": "<SectionRule> doesn't accept that prop. Declared props: tone, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|size|tone|underline|state|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, size, tone, underline, state, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|active)$/]",
        "message": "<TextLink> state must be one of 'default' | 'active'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Underline'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|on|duration|tone|style|key|ref|className|style|children)$/]",
        "message": "<Underline> doesn't accept that prop. Declared props: width, height, on, duration, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnderlineAnimation'] > JSXAttribute > JSXIdentifier[name!=/^(?:property1|on|width|style|key|ref|className|style|children)$/]",
        "message": "<UnderlineAnimation> doesn't accept that prop. Declared props: property1, on, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnderlineAnimation'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|variant2)$/]",
        "message": "<UnderlineAnimation> property1 must be one of 'default' | 'variant2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatWeDoStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|label|body|key|ref|className|style|children)$/]",
        "message": "<WhatWeDoStep> doesn't accept that prop. Declared props: n, label, body."
      }
    ]
  },
